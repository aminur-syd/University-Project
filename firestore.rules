rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isUser() {
      return request.auth != null;
    }

    function isStaff() {
      return isUser() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['staff', 'admin'];
    }

    function isAdmin() {
      return isUser() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isItemOwner(itemData) {
      return isUser() && itemData.createdBy == request.auth.uid;
    }

    function isPublicApprovedActiveItem(itemData) {
      return itemData.reviewStatus == 'approved' && itemData.status == 'active';
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isUser() && request.auth.uid == userId;
      allow update: if (isUser() && request.auth.uid == userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /items/{itemId} {
      allow read: if isPublicApprovedActiveItem(resource.data) ||
        isStaff() ||
        isItemOwner(resource.data);

      allow create: if isUser() && request.resource.data.createdBy == request.auth.uid;

      allow update: if isStaff();

      allow delete: if isAdmin();

      match /comments/{commentId} {
        function parentItem() {
          return get(/databases/$(database)/documents/items/$(itemId));
        }

        allow read: if isPublicApprovedActiveItem(parentItem().data) ||
          isStaff() ||
          isItemOwner(parentItem().data);

        allow create: if isUser() &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.status == 'visible' &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.creatorName is string &&
          parentItem().data.type == 'found' &&
          parentItem().data.reviewStatus == 'approved' &&
          parentItem().data.status == 'active';

        allow update, delete: if isAdmin();
      }
    }

    match /claims/{claimId} {
      allow read: if (isUser() && resource.data.claimerUid == request.auth.uid) || isStaff();
      allow create: if isUser();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /mail/{mailId} {
      allow create: if isUser();
      allow read, update, delete: if false;
    }

    match /chats/{chatId} {
      allow create: if isUser() && request.resource.data.userId == request.auth.uid;
      allow read, update: if isStaff() || (isUser() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, create: if isStaff() ||
          (isUser() && get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid);
        allow update, delete: if isAdmin();
      }
    }
  }
}
