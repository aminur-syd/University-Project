rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isUser() {
      return request.auth != null;
    }

    function isStaff() {
      return isUser() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['staff', 'admin'];
    }

    function isAdmin() {
      return isUser() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isItemOwner(itemData) {
      return isUser() && itemData.createdBy == request.auth.uid;
    }

    function isApprovedActiveItem(itemData) {
      return itemData.reviewStatus == 'approved' && itemData.status == 'active';
    }

    function canReadItem(itemData) {
      return (
        isItemOwner(itemData) ||
        isStaff() ||
        isApprovedActiveItem(itemData)
      );
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isUser() && request.auth.uid == userId;
      allow update: if (isUser() && request.auth.uid == userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /items/{itemId} {
      allow read: if canReadItem(resource.data);

      allow create: if isUser() && request.resource.data.createdBy == request.auth.uid;

      allow update: if isStaff();

      allow delete: if isAdmin();

      match /comments/{commentId} {
        function parentItem() {
          return get(/databases/$(database)/documents/items/$(itemId));
        }

        allow read: if
          resource.data.status == 'visible' &&
          parentItem().data.type == 'found' &&
          canReadItem(parentItem().data);

        allow create: if isUser() &&
          request.resource.data.keys().hasOnly(['text', 'createdBy', 'creatorName', 'createdAt', 'status']) &&
          request.resource.data.createdBy is string &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.status == 'visible' &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.creatorName is string &&
          request.resource.data.creatorName.size() > 0 &&
          request.resource.data.createdAt == request.time &&
          parentItem().data.type == 'found' &&
          isApprovedActiveItem(parentItem().data);

        allow update, delete: if isAdmin();
      }
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();

      allow create: if isUser() &&
        request.resource.data.keys().hasAll(['type', 'message', 'actorUid', 'actorName', 'targetId', 'targetType', 'createdAt']) &&
        request.resource.data.keys().hasOnly(['type', 'message', 'actorUid', 'actorName', 'targetId', 'targetType', 'createdAt', 'meta']) &&
        request.resource.data.type is string &&
        request.resource.data.type.size() > 0 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.actorName is string &&
        request.resource.data.actorName.size() > 0 &&
        request.resource.data.targetId is string &&
        request.resource.data.targetType is string &&
        request.resource.data.createdAt == request.time &&
        (!('meta' in request.resource.data) || request.resource.data.meta is map);

      allow update: if false;
      allow delete: if isAdmin();
    }

    match /claims/{claimId} {
      allow read: if (isUser() && resource.data.claimerUid == request.auth.uid) || isStaff();
      allow create: if isUser();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /mail/{mailId} {
      allow create: if isUser();
      allow read, update, delete: if false;
    }

    match /chats/{chatId} {
      allow create: if isUser() && request.resource.data.userId == request.auth.uid;
      allow read, update: if isStaff() || (isUser() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, create: if isStaff() ||
          (isUser() && get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid);
        allow update, delete: if isAdmin();
      }
    }
  }
}
