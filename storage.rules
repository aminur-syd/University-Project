rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /items/{userId}/{fileName} {
      allow read: if true; // Public can see item images
      allow write: if request.auth != null && request.auth.uid == userId && request.resource.size < 5 * 1024 * 1024; // 5MB limit
    }
    match /claims/{userId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['staff', 'admin']);
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
